    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "GB Studio only fills projectile slots 0-4. With Max projectile",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000227"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "slots raised to 8, the plugin Load/Launch Slot events reach 5-7,",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000228"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "each holding a different sprite/speed/lifetime definition.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000229"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "EXTRA SLOTS\n\nSlots 5,6,7 loaded\non init.",
          "B: slot 5 wave\nA: slot 6 arc\nSELECT: slot 7",
          "DOWN: fixed tile.\nUP: random pixel\ncolumn.",
          "LEFT: aim at the\ntarget. RIGHT: point\nto point."
        ]
      },
      "id": "e0000000-0000-4000-8000-000000000230"
