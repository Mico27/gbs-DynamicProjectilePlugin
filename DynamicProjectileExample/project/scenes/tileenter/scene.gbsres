    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "point crosses into a new cell of the Tile enter grid engine",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000304"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "setting. Life Time 0 means these never expire on their own.",
