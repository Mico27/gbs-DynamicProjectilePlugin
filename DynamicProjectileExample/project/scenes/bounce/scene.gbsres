  "x": 820,
  "y": 560,
  "script": [
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Gravity pulls the projectile down; the collision behaviour",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000168"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "decides what happens when it reaches a solid tile.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000169"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "The tile hit script fires on every bounce, not just on removal.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000170"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "There is one script per tile face, so the print says which side",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000171"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "was struck. SELECT's shot unticks Run Tile Hit Script instead,",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000172"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "so it stays silent whichever face it reaches.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000173"
    },
