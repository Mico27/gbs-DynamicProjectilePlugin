  "y": 560,
  "script": [
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Hookshot: one 'Head' projectile plus three chain links, which",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000079"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "always span the line from the source actor to the head - walk",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000080"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "around with a hook out and the chain follows.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000081"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "A picks which On Tile Hit / On Actor Hit reactions B fires with.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000082"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "The two impact scripts are set once here by their own events and",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000083"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "read back what was hit through the Last Hit engine fields.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000084"
    },
