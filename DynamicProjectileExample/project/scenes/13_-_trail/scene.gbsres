  "_index": 13,
  "name": "13 - Trail",
  "symbol": "scene_trail",
  "backgroundId": "b0000000-0000-4000-8000-000000000001",
  "tilesetId": "",
  "width": 20,
  "height": 18,
  "type": "TOPDOWN",
  "colorModeOverride": "none",
  "paletteIds": [],
  "spritePaletteIds": [],
  "playerSpriteSheetId": "581d34d0-9591-4e6e-a609-1d94f203b0cd",
  "collisions": "0f15+0012+0f2+0012+0f2+0012+0f2+0012+0f2+004+0f2+006+0f2+004+0f2+004+0f2+006+0f2+004+0f2+0012+0f2+0012+0f2+0012+0f2+0012+0f2+004+0f2+006+0f2+004+0f2+004+0f2+006+0f2+004+0f2+0012+0f2+0012+0f2+0012+0f2+0012+0f15+",
  "autoFadeSpeed": 1,
  "x": 1600,
  "y": 300,
  "script": [
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Trail: a projectile that travels like any other but remembers",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000282"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "where it has been, and hangs a sprite off its own history every",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000283"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "few passes. The segments hurt as much as the head does.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000284"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "B hops under gravity and bounces off the floor; A flies straight",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000285"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "at whatever it is aimed at, with a longer tail.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000286"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "SELECT hangs a trail off an ACTOR instead - the projectile stops",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000287"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "moving and just follows the player, so it becomes an actor with a",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000288"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "tail rather than a tail with a head on the front.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000289"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "TRAIL\n\nB: hopping trail\n(4 segments)",
          "A: straight trail\n(flies at target,\n6 segments)",
          "SELECT: tail hung\non YOU - walk to\ntrail it behind.",
          "Only 2 can be out\nat once.\nSTART: menu"
        ]
      },
      "id": "e0000000-0000-4000-8000-000000000290"
    },
