  "script": [
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Anchor: the projectile is rigidly attached to an actor and",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000138"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "mirrors its facing - handy for held weapons. The actor is named",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000139"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "per projectile, so both of these can be out at the same time.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000140"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "ANCHOR\n\nB: attach to you\nA: attach to the",
          "target actor. Both\ncan be out at once.\nSTART: menu"
