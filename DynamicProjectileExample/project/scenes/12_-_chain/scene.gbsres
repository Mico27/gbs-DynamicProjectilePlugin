  "x": 1340,
  "y": 300,
  "script": [
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Chain: one projectile that draws a run of sprites between two",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000266"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "actors. Straight spreads the links evenly along the line; Loose",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000267"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "lets each link lag behind its neighbour and catch up, so the",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000268"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "chain hangs and drags instead of staying taut.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000269"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "Both are strung from the player to the Target actor, so walking",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000270"
    },
    {
      "command": "EVENT_COMMENT",
      "args": {
        "text": "around is what shows the difference.",
        "__collapse": true
      },
      "id": "e0000000-0000-4000-8000-000000000271"
    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "CHAIN\n\nB: straight chain\nA: loose chain",
          "Walk around while\none is out to see\nit follow.",
          "Each lasts 4s. Only\n2 can be out at\nonce. START: menu"
        ]
      },
      "id": "e0000000-0000-4000-8000-000000000272"
    },
